{
  "name": "pusher-desktop",
  "version": "0.1.0",
  "description": "本机 iOS 与 Android 推送测试工具",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
